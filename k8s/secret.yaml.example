# Template only — do not commit real secrets.
# Create the secret before deploying:
#   kubectl create secret generic btp-is-alert-service-secrets \
#     --from-literal=CPI_TOKEN_URL='https://...' \
#     --from-literal=CPI_CLIENT_ID='...' \
#     --from-literal=CPI_CLIENT_SECRET='...' \
#     --from-literal=EM_TOKEN_URL='https://...' \
#     --from-literal=EM_CLIENT_ID='...' \
#     --from-literal=EM_CLIENT_SECRET='...'
#
# Or apply this file after replacing placeholders (not recommended for production):
apiVersion: v1
kind: Secret
metadata:
  name: btp-is-alert-service-secrets
  namespace: dev-service
  labels:
    app: btp-is-alert-service
type: Opaque
stringData:
  CPI_TOKEN_URL: "https://your-tenant.authentication.us10.hana.ondemand.com/oauth/token"
  CPI_CLIENT_ID: "replace-me"
  CPI_CLIENT_SECRET: "replace-me"
  EM_TOKEN_URL: "https://your-tenant.authentication.us10.hana.ondemand.com/oauth/token"
  EM_CLIENT_ID: "replace-me"
  EM_CLIENT_SECRET: "replace-me"
